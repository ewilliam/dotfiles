# Fish
alias fr='source ~/.config/fish/config.fish'

# Alias
alias ae='vi ~/.dotfiles/cli/fish/aliases'

# Clear
alias cl='clear'

# List
alias lsg='ll | sift'

# Change directory
alias ..='cd ..'
alias ...='cd ../../'
alias ....='cd ../../../'
alias .....='cd ../../../../'

# Concatenate
alias catg='cat .gitignore'

# Kill
alias ka9='killall -9'
alias k9='kill -9'

# Tail
alias tfdl='tail -f log/development.log'
alias tftl='tail -f log/test.log'

# PS
alias pss='ps aux | sift'
alias psp='ps aux | peco'

# Git
alias gs='git status'
alias gcm='git ci -m'
alias gc='git ci'
alias gco='git co'
alias ga='git add -A'
alias gm='git merge'
alias grr='git remote rm'
alias grad='git remote add'
alias gr='git rebase'
alias gl='git l'
alias gd='git diff'
alias gb='git b'
alias gcl='git clone'
alias gpl='git pull'
alias gp='git push'
alias gpo='git push origin'
alias gpom='git push origin master'
alias gphm='git push heroku master'
alias gcam='git commit --amend -m'
alias gnb='git nb'
alias grs='git reset'
alias grsh='git reset --hard'

# Tmux
alias tn='tmux new-session -s'
alias tl='tmux list-sessions'
alias ta='tmux attach-session'
alias tksesh='tmux kill-session'
alias tkserv='tmux kill-server'

# Vim
alias vi='nvim'
alias ve='vi ~/.vim/vimrc'

# Bundler
alias be='bundle exec'
alias ber='bundle exec rake'

# Ruby
alias gemu='gem update --system;  gem update; gem cleanup'
alias rpry='pry-remote'
alias bpry='bundle exec pry -r ./config/environment'

# Rails
alias rs='bundle exec rails server'
alias rg='bundle exec rails generate'
alias rgc='bundle exec rails generate controller'
alias rgm='bundle exec rails generate model'
alias rgmi='bundle exec rails generate migration'
alias rgd='bundle exec rails generate devise'
alias rgit='bundle exec rails generate integration_test'
alias c='rails c'

alias dbcreate='bundle exec spring rake db:create'
alias dbreset='bundle exec spring rake db:reset'
alias dbseed='bundle exec spring rake db:seed'
alias dbsetup='bundle exec spring rake db:setup'
alias dbtp='spring rake db:test:prepare'
alias dbm='spring rake db:migrate'
alias dbmr='spring rake db:migrate:redo'
alias dbmd='spring rake db:migrate:down'
alias dbmu='spring rake db:migrate:up'

alias assetize='RAILS_ENV=production bundle exec rake assets:precompile'

alias igv='echo '/vendor' >> .gitignore'

## Python
alias pip2u='pip list --outdated | cut -d " " -f1 | xargs -n1 pip install -U'
alias pip3u='pip3 list --outdated | cut -d " " -f1 | xargs -n1 pip3 install -U'
alias pipu='pip2u; pip3u'

# Newsbeuter
alias news='newsbeuter'

# Pianobar
alias music='pianobar'
