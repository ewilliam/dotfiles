#
# Aliases
#
# Fish
alias frl='source ~/.config/fish/config.fish'

# Clear
alias cl='clear'

# List
alias l='ls -alGh'
alias lg='ls -alGh | rg'

# Directory
alias ..='cd ..'
alias ...='cd ../../'
alias ....='cd ../../../'
alias .....='cd ../../../../'

# Tail
alias tlf='tail -f'

# Process
alias psg='ps aux | rg'
alias psp='ps aux | peco'
alias ka9='killall -9'
alias k9='kill -9'

# System
alias df='df -h'
alias du='du -sh'

# Git
alias gst='git status'
alias glg='git log'
alias gad='git add'
alias gci='git commit'
alias gcm='git commit -m'
alias gcam='git commit --amend -m'
alias gco='git checkout'
alias gme='git merge'
alias grb='git rebase'
alias grm='git remote rm'
alias gra='git remote add'
alias gdi='git diff'
alias gbr='git branch'
alias gcl='git clone'
alias gpl='git pull'
alias gps='git push'
alias gpo='git push origin'
alias gph='git push heroku'
alias grs='git reset'

# Vim
alias vi='nvim'
alias ve='nvim ~/.config/nvim/init.vim'

# Tmux
alias muxn='tmux new-session -s'
alias muxl='tmux list-sessions'
alias muxa='tmux attach-session'

# Ruby
alias be='bundle exec'
alias ber='bundle exec rake'
alias gemu='gem update --system; gem update; gem cleanup'
alias rpry='pry-remote'
alias bpry='bundle exec pry -r ./config/environment'

# Python
alias pip2u='pip2 list --outdated | cut -d " " -f1 | xargs -n1 pip2 install -U'
alias pip3u='pip3 list --outdated | cut -d " " -f1 | xargs -n1 pip3 install -U --user'
alias pipu='pip2u; pip3u'

# Neomutt
alias mail='neomutt'

# Newsboat
alias news='newsboat'

# Pianobar
alias music='pianobar'
