# SSH client configuration
# Managed by dotfiles — do not edit directly.
#
# OrbStack injects its own config via Include (must be first, before any Host blocks).
# Uncomment the line below once OrbStack is installed.
# Include ~/.orbstack/ssh/config

IgnoreUnknown UseKeychain

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  # Route SSH auth through the 1Password agent.
  # 1Password must be running and SSH agent integration must be enabled in its settings.
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Work GitHub account — use a separate key managed in 1Password.
# Clone work repos with: git clone git@github.com-csd:org/repo.git
# Host github.com-csd
#   Hostname github.com
#   User git
#   IdentityFile ~/.ssh/id_csd
